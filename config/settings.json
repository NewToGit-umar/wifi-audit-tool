        "hashcat_mode": 22000,
        "wordlist_path": "/usr/share/wordlists/rockyou.txt",
        "max_cracking_time": 3600
    },
    "wps": {
        "pixie_attack": true,
        "bruteforce_delay": 1,
        "max_attempts": 100
    }
}