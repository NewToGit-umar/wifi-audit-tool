{
    "general": {
        "theme": "dark",
        "auto_save_logs": true,
        "max_log_size_mb": 10,
        "language": "en"
    },
    "scanning": {
        "default_scan_time": 30,
        "show_hidden_networks": true,
        "min_signal": -80,
